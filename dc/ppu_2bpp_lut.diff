diff --git a/src/snes/ppu.c b/src/snes/ppu.c
--- a/src/snes/ppu.c
+++ b/src/snes/ppu.c
@@ -303,6 +303,12 @@
 #define DO_PIXEL_HFLIP(i) do { \
   pixel = (bits >> (7 - i)) & 1 | (bits >> (14 - i)) & 2; \
   if (pixel && z > dstz[i]) dstz[i] = z + pixel; } while (0)
+#define DO_PIXEL_FAST(i) do { \
